#!/bin/sh
# Run once on first boot, after luci-app-openclash and mihomo-meta are present.
# Keep OpenClash on the locally compiled core; the user may later replace it
# explicitly from the OpenClash UI if they choose to do so.

if [ -x /usr/libexec/mihomo ]; then
	mkdir -p /etc/openclash/core
	ln -sfn /usr/libexec/mihomo /etc/openclash/core/clash_meta
	uci -q set openclash.config.core_type='Meta'
	uci -q set openclash.config.core_version='0'
	uci -q commit openclash
fi

exit 0
