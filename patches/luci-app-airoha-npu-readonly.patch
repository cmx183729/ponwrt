-		val=$(($(devmem $CR_CPUPLL_SDM_PCW_CHG)))
-		val=$(( ($val & 0xFFFFFF8F) | (posdiv << 4) ))
-	fi
-
-	if [ $(( $val & 1 )) -eq 1 ]; then
-		val=$(( $val & ~1 ))
-	else
-		val=$(( $val | 1 ))
-	fi
-	devmem $CR_CPUPLL_SDM_PCW_CHG 32 $(printf "0x%08X" $val)
-}
