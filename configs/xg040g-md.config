# XG-040G-MD final image overlay.
#
# This file is intentionally merged LAST, after configs/an7581.config and
# configs/release.config.  It only controls the selected image and upper-layer
# packages.  Do not move PON, BOSA/RI, DTS, pon0, or board network definitions
# into this overlay.

# Build one known-safe UBI device image, not the multi-profile/USB-SFP variant.
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# Build-only acceleration; GitHub Actions supplies CCACHE_DIR.
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR=""

# Preserve the existing Airoha NPU firmware and expose read-only SoC/PPE status.
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
# Frame Engine status is read-only in the locally patched LuCI application.
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

# Do not spend image/RAM on kernel debugging metadata.  Keep DEBUG_FS above,
# because the NPU/PPE read-only dashboard uses debugfs counters.
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_COREDUMP is not set
# CONFIG_KERNEL_ELF_CORE is not set

# Airoha PPE/NFT flow offload.  This tree calls the flow module kmod-nf-flow.
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# OpenClash: nftables firewall4 path, TUN/TPROXY support, and a locally built
# Meta core.  Do not enable legacy iptables/ipset packages for this firewall4
# image unless a future OpenClash profile explicitly requires them.
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_xg040-openclash-core-link=y

# MosDNS v5 and the exact data packages required by its LuCI front end.
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_geo2txt=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_ucode=y

# Native AdGuard Home package: it has its own web UI and avoids a second LuCI
# wrapper/service with conflicting init/config filenames.
CONFIG_PACKAGE_adguardhome=y
# CONFIG_PACKAGE_luci-app-adguardhome is not set

# Minimal iStore front end plus its required task runner.  luci-lib-xterm is a
# browser-side JavaScript library, not ttyd and not a listening terminal daemon.
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_mount-utils=y

# Routing and lightweight visibility.  LuCI Status supplies real-time load,
# bandwidth and connection views without collectd/nlbwmon/wrtbwmon daemons.
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y

# Full native IPv6/PD support and optional NAT66 kernel capability.  No UCI
# network or firewall interface mapping is changed here.
CONFIG_IPV6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_kmod-nf-nat6=y

# Keep the existing LuCI theme and practical USB storage/mount stack.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# Mandatory memory/attack-surface exclusions.
# CONFIG_PACKAGE_ttyd is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_etherwake is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_watchcat is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-go is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set
# CONFIG_PACKAGE_podman is not set
# CONFIG_PACKAGE_luci-app-podman is not set
# CONFIG_PACKAGE_samba4-libs is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_ksmbd-server is not set
# CONFIG_PACKAGE_aria2 is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_transmission-daemon is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_netdata is not set
# CONFIG_PACKAGE_luci-app-netdata is not set
# CONFIG_PACKAGE_collectd is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_nlbwmon is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_wrtbwmon is not set
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set
# CONFIG_PACKAGE_tailscale is not set
# CONFIG_PACKAGE_zerotier is not set
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_openvpn-openssl is not set
# CONFIG_PACKAGE_luci-app-openvpn is not set
# CONFIG_PACKAGE_strongswan is not set
